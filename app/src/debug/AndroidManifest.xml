<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Debug builds only: lets `adb shell am start` open the settings screen directly, since
             the real entry point is a three-second Volume Down hold that adb cannot synthesise.
             The release manifest keeps this activity unexported. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            tools:replace="android:exported"/>
    </application>
</manifest>
